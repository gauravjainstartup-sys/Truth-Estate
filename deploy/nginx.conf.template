# ════════════════════════════════════════════════════════════════
#  Static export, served from Cloud Run.
#
#  The build output is 1259 files of prerendered HTML. The only reasons
#  it needs a server rather than a bucket are the two things a bucket
#  cannot do and GitHub Pages could never do either:
#
#    301s. The old truthestate.in URLs have to arrive at the new ones
#    with their ranking intact. This repo already carries 294 JS-redirect
#    "legacy stubs" precisely because GitHub Pages cannot issue a 301;
#    behind nginx they become real ones.
#
#    Headers. Immutable caching for hashed assets, revalidation for HTML,
#    and the security headers a static host will not set for you.
# ════════════════════════════════════════════════════════════════

# ── Cache-Control by path, decided here rather than per-location ──
#
# THIS IS NOT A STYLE CHOICE. `add_header` does not merge with the parent
# scope, it REPLACES it: any location block with its own add_header loses
# every header set on the server. The first version of this file set the
# security headers at server level and Cache-Control inside three
# location blocks, so every asset and every HTML page — which is to say
# the entire site — was served with no X-Content-Type-Options, no
# Referrer-Policy and no X-Frame-Options. Valid config, silent hole.
#
# A map computes the value instead, and the headers are set exactly once.
map $uri $cache_control {
  default                          "public, max-age=0, must-revalidate";
  ~^/_next/static/                 "public, max-age=31536000, immutable";
  ~*\.(?:png|jpe?g|webp|avif|svg|ico|woff2?)$  "public, max-age=2592000";
  ~*\.html$                        "public, max-age=0, must-revalidate";
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Cloud Run terminates TLS at the edge and forwards the original scheme.
  # Without reading it, a redirect would send an https visitor to http and
  # cost them a round trip through a browser warning.
  set $fwd_proto $http_x_forwarded_proto;
  if ($fwd_proto = "") { set $fwd_proto "https"; }

  # nginx builds redirects from the port it is LISTENING on, not the one
  # the visitor reached. Behind Cloud Run that is 8080, so any implicit
  # redirect would hand out http://www.truthestate.in:8080/… — a URL that
  # is not reachable from the internet. Both directives off, and relative
  # Location headers instead.
  absolute_redirect off;
  port_in_redirect off;

  # ── canonical host ──
  # One host serves the site: the APEX (truthestate.in) — the host Google has
  # already indexed (all 4,793 URLs on the bare domain). Apex and www are
  # separate sites to Google, so the www copy 301s onto the apex: all equity
  # on one host, and no site-wide host change layered on the platform move.
  if ($host = "www.truthestate.in") {
    return 301 $fwd_proto://truthestate.in$request_uri;
  }

  # ── the shape GitHub Pages served, preserved ──
  # /office resolves to office.html, /intelligence/markets to markets.html.
  # tests/pages-server.py exists because a plain file server maps /office
  # to a directory listing instead, and testing against the wrong one
  # invents failures production never had. Production keeps behaving the
  # way the tests assume.
  location / {
    try_files $uri $uri.html $uri/index.html =404;
  }

  # Hashed assets: never revalidate, and never fall through to the HTML
  # handler — a missing chunk should 404, not return a page.
  # `^~` so this beats any regex location; without it the image regex
  # below could claim /_next/static/*.svg and change its caching.
  location ^~ /_next/static/ {
    try_files $uri =404;
  }

  # ── everything under /projects/ ──
  # `^~` so this whole prefix is decided here, not by the generic `location /`.
  # It lets an is_live project that has no baked file YET fall through to the
  # live shell instead of 404ing, while a baked report still serves its own file
  # first (try_files order). Exact `=` matches — the three redirects below and
  # every line in redirects.conf — still beat this prefix, so no old-URL 301 is
  # shadowed.
  location ^~ /projects/ {
    # legacy /projects/<slug>/locked → the report. Nested here because a
    # top-level `^~` would otherwise shadow a top-level regex; a per-slug `=` in
    # redirects.conf still wins over this. The old site exposed a paywalled
    # /locked variant of each report that Google indexed; this build has no
    # /locked route, so fold it onto the canonical report.
    location ~ ^/projects/(.+?)/locked/?$ {
      return 301 /projects/$1;
    }
    # A baked report serves its own file. An is_live project not baked yet falls
    # to the live shell (out/live-project.html), which resolves the real slug
    # against the live set and renders it through the report UI. The next build
    # turns it into a static, indexable, sitemap-listed page. The shell is
    # noindex, so a genuinely-unknown slug landing here is never indexed.
    try_files $uri $uri.html /live-project.html;
  }

  # ── legacy /compare/<a>-vs-<b> fallback → /intelligence/compare/<a>-vs-<b> ──
  # Exact per-pair rules in redirects.conf win over this regex (= beats ~).
  # If a pair is not explicitly listed, redirect directly to /intelligence/compare/$1
  # to preserve the user's intent and retain search equity.
  location ~ ^/compare/(.+)$ {
    return 301 /intelligence/compare/$1;
  }
  location = /compare { return 301 /intelligence/compare; }
  location = /compare/ { return 301 /intelligence/compare; }

  # ── legacy /developers/... routes → /intelligence/developers/... ──
  location ~ ^/developers/gurugram-real-estate-(.+?)-review-track-record-financials/?$ {
    return 301 /intelligence/developers/$1;
  }
  location ~ ^/developers/(.+)$ {
    return 301 /intelligence/developers/$1;
  }
  # NOTE: the bare `= /developers` is intentionally NOT defined here —
  # redirects.conf already carries it (it's in indexed-urls.txt), and an
  # exact location defined in both files is a duplicate that makes nginx
  # refuse to start. Only the trailing-slash form (absent from redirects.conf)
  # is added; /developers/<slug> is handled by the regex above.
  location = /developers/ { return 301 /intelligence/developers; }

  # ── old project URLs Google still ranks, renamed since → their current reports ──
  # From the GSC Performance export: earning impressions while 404ing. Kept here
  # by hand (not via build-redirects.mjs); do NOT also list them in
  # deploy/indexed-urls.txt, or a regen would emit a duplicate `location =`.
  location = /projects/gurugram-real-estate-godrej-habitat-sohna-road-sector-3 {
    return 301 /projects/gurugram-real-estate-godrej-habitat-nh-8-corridor-sector-3;
  }
  location = /projects/gurugram-real-estate-m3m-capital-phase-2-gurugram-sector-113 {
    return 301 /projects/gurugram-real-estate-m3m-capital-dwarka-expressway-sector-113;
  }
  location = /projects/gurugram-real-estate-aspen-one-gurugram-sector-76 {
    return 301 /projects/gurugram-real-estate-whiteland-aspen-one-southern-peripheral-road-spr-corridor-sector-76;
  }
  # NOTE: the puri-diplomatic-residences-sector-111 alias is NOT hand-listed
  # here — redirects.conf already carries it (same target, via indexed-urls.txt).
  # Defining it in both is a duplicate location that stops nginx from starting.
  location = /projects/gurugram-real-estate-delphine-central-park-estates-phase-3-dwarka-expressway-sector-104 {
    return 301 /projects/gurugram-real-estate-delphine-central-park-estates-phase-2-dwarka-expressway-sector-104;
  }

  # ── the bare /best-projects hub → the Truth-Score-ranked catalogue ──
  # There is no /best-projects index page (only the /best-projects/<slug>
  # filtered landings), so the bare hub 404s. It is also the most likely home
  # of the old "Best & Safe Projects to Invest in Gurugram" page, whose exact
  # URL neither the crawl nor the GSC exports still hold. /intelligence/projects
  # already sorts by Truth Score by default, so it IS the best-projects list.
  # Both spellings, since = /best-projects does not match the trailing slash.
  location = /best-projects { return 301 /intelligence/projects; }
  location = /best-projects/ { return 301 /intelligence/projects; }
  # NOTE: `= /under-construction-projects-in-gurugram` is intentionally NOT
  # defined here — redirects.conf already carries it (→ /intelligence/projects,
  # from indexed-urls.txt). Defining it in both is a duplicate location that
  # stops nginx from starting.

  # ── 301s from the old site ──
  # Generated by scripts/build-redirects.mjs. Its own file so the map can
  # be regenerated without touching the server config.
  include /etc/nginx/redirects.conf;

  # ── headers, set once, applied everywhere ──
  # `always` so they are present on error responses too — a 404 page with
  # no nosniff is still a page a browser will sniff.
  add_header Cache-Control $cache_control always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;
  gzip_min_length 1024;

  error_page 404 /404.html;

  # Cloud Run's health probe. Out of the access log so it does not drown
  # the real traffic.
  location = /_healthz {
    access_log off;
    add_header Cache-Control "no-store" always;
    return 200 "ok\n";
  }
}
