# ════════════════════════════════════════════════════════════════
#  Static export, served from Cloud Run.
#
#  The build output is 1259 files of prerendered HTML. The only reasons
#  it needs a server rather than a bucket are the two things a bucket
#  cannot do and GitHub Pages could never do either:
#
#    301s. The old truthestate.in URLs have to arrive at the new ones
#    with their ranking intact. This repo already carries 294 JS-redirect
#    "legacy stubs" precisely because GitHub Pages cannot issue a 301;
#    behind nginx they become real ones.
#
#    Headers. Immutable caching for hashed assets, revalidation for HTML,
#    and the security headers a static host will not set for you.
# ════════════════════════════════════════════════════════════════

# ── Cache-Control by path, decided here rather than per-location ──
#
# THIS IS NOT A STYLE CHOICE. `add_header` does not merge with the parent
# scope, it REPLACES it: any location block with its own add_header loses
# every header set on the server. The first version of this file set the
# security headers at server level and Cache-Control inside three
# location blocks, so every asset and every HTML page — which is to say
# the entire site — was served with no X-Content-Type-Options, no
# Referrer-Policy and no X-Frame-Options. Valid config, silent hole.
#
# A map computes the value instead, and the headers are set exactly once.
map $uri $cache_control {
  default                          "public, max-age=0, must-revalidate";
  ~^/_next/static/                 "public, max-age=31536000, immutable";
  ~*\.(?:png|jpe?g|webp|avif|svg|ico|woff2?)$  "public, max-age=2592000";
  ~*\.html$                        "public, max-age=0, must-revalidate";
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Cloud Run terminates TLS at the edge and forwards the original scheme.
  # Without reading it, a redirect would send an https visitor to http and
  # cost them a round trip through a browser warning.
  set $fwd_proto $http_x_forwarded_proto;
  if ($fwd_proto = "") { set $fwd_proto "https"; }

  # nginx builds redirects from the port it is LISTENING on, not the one
  # the visitor reached. Behind Cloud Run that is 8080, so any implicit
  # redirect would hand out http://www.truthestate.in:8080/… — a URL that
  # is not reachable from the internet. Both directives off, and relative
  # Location headers instead.
  absolute_redirect off;
  port_in_redirect off;

  # ── canonical host ──
  # One host serves the site: the APEX (truthestate.in) — the host Google has
  # already indexed (all 4,793 URLs on the bare domain). Apex and www are
  # separate sites to Google, so the www copy 301s onto the apex: all equity
  # on one host, and no site-wide host change layered on the platform move.
  if ($host = "www.truthestate.in") {
    return 301 $fwd_proto://truthestate.in$request_uri;
  }

  # ── the shape GitHub Pages served, preserved ──
  # /office resolves to office.html, /intelligence/markets to markets.html.
  # tests/pages-server.py exists because a plain file server maps /office
  # to a directory listing instead, and testing against the wrong one
  # invents failures production never had. Production keeps behaving the
  # way the tests assume.
  location / {
    try_files $uri $uri.html $uri/index.html =404;
  }

  # Hashed assets: never revalidate, and never fall through to the HTML
  # handler — a missing chunk should 404, not return a page.
  # `^~` so this beats any regex location; without it the image regex
  # below could claim /_next/static/*.svg and change its caching.
  location ^~ /_next/static/ {
    try_files $uri =404;
  }

  # ── legacy /projects/<slug>/locked → the report ──
  # The old site exposed a locked (paywalled) variant of each report at
  # /projects/<slug>/locked, and Google indexed roughly one per project. This
  # build has no /locked route — the report itself IS the canonical page — so
  # fold the variant onto it. A regex covers every slug in one rule instead of
  # a per-project line in redirects.conf. Regex loses to the `=` exact matches
  # in redirects.conf, so it can never shadow a more specific redirect.
  location ~ ^/projects/(.+?)/locked/?$ {
    return 301 /projects/$1;
  }

  # ── 301s from the old site ──
  # Generated by scripts/build-redirects.mjs. Its own file so the map can
  # be regenerated without touching the server config.
  include /etc/nginx/redirects.conf;

  # ── headers, set once, applied everywhere ──
  # `always` so they are present on error responses too — a 404 page with
  # no nosniff is still a page a browser will sniff.
  add_header Cache-Control $cache_control always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;
  gzip_min_length 1024;

  error_page 404 /404.html;

  # Cloud Run's health probe. Out of the access log so it does not drown
  # the real traffic.
  location = /_healthz {
    access_log off;
    add_header Cache-Control "no-store" always;
    return 200 "ok\n";
  }
}
